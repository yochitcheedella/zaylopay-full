@echo off
setlocal
cd /d "%~dp0"

REM Uses process-local environment variables only. Nothing is written to disk or setx.
powershell -NoProfile -ExecutionPolicy Bypass -Command "& { $secure = Read-Host 'MySQL password' -AsSecureString; $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure); $otpBstr = [IntPtr]::Zero; $mavenExitCode = 1; try { $env:DB_PASSWORD = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr); if (Test-Path 'C:\Program Files\Java\jdk-21\bin\java.exe') { $env:JAVA_HOME = 'C:\Program Files\Java\jdk-21'; $env:Path = 'C:\Program Files\Java\jdk-21\bin;' + $env:Path }; if ([string]::IsNullOrWhiteSpace($env:DB_URL)) { $env:DB_URL = 'jdbc:mysql://localhost:3306/zaylope?allowPublicKeyRetrieval=true&sslMode=DISABLED' }; if ([string]::IsNullOrWhiteSpace($env:DB_USERNAME)) { $env:DB_USERNAME = 'root' }; if ([string]::IsNullOrWhiteSpace($env:SERVER_PORT)) { $env:SERVER_PORT = '8080' }; if ([string]::IsNullOrWhiteSpace($env:APP_CORS_ALLOWED_ORIGIN)) { $env:APP_CORS_ALLOWED_ORIGIN = 'http://localhost:5173' }; $userGoogleClientId = [Environment]::GetEnvironmentVariable('GOOGLE_CLIENT_ID', 'User'); if ([string]::IsNullOrWhiteSpace($env:GOOGLE_CLIENT_ID) -or ($env:GOOGLE_CLIENT_ID -eq '454795409862-ts4fuqo7oqig1fadfkatbgflqtlh8uhe.apps.googleusercontent.com' -and -not [string]::IsNullOrWhiteSpace($userGoogleClientId))) { $env:GOOGLE_CLIENT_ID = $userGoogleClientId }; if (($env:SPRING_PROFILES_ACTIVE -eq 'dev' -or $env:MOBILE_OTP_ENABLED -eq 'true' -or $env:EMAIL_OTP_ENABLED -eq 'true' -or $env:OTP_MOCK_DELIVERY -eq 'true') -and [string]::IsNullOrWhiteSpace($env:OTP_HASH_KEY)) { $otpSecure = Read-Host 'OTP hash secret (at least 32 bytes; reuse the same secret across restarts)' -AsSecureString; $otpBstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($otpSecure); $env:OTP_HASH_KEY = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($otpBstr) }; & .\mvnw.cmd spring-boot:run; $mavenExitCode = $LASTEXITCODE } finally { if ($otpBstr -ne [IntPtr]::Zero) { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($otpBstr) }; Remove-Item Env:OTP_HASH_KEY -ErrorAction SilentlyContinue; if ($bstr -ne [IntPtr]::Zero) { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr) }; Remove-Item Env:DB_PASSWORD -ErrorAction SilentlyContinue }; exit $mavenExitCode }"
