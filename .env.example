# Backend process environment. Spring Boot does not load this file automatically.
# Set DB_URL explicitly to a dedicated development database before starting the backend.
# Do not point this application at the unrelated, populated zaylo_db schema.
DB_URL=jdbc:mysql://localhost:3306/zaylope?allowPublicKeyRetrieval=true&sslMode=DISABLED
DB_USERNAME=replace-with-local-db-user
DB_PASSWORD=

# Required externally for bank encryption. Existing installations MUST retain
# their current key; changing it requires a separate encrypted-data migration.
# New isolated installations should generate a random secret outside Git.
BANK_ENCRYPTION_KEY=

# Email configuration; provide values only in local environment/deployment secrets.
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=

# With SPRING_PROFILES_ACTIVE=dev, local OTP delivery defaults to the console-only mock.
# Production profile defaults remain disabled and must use real delivery providers.
MOBILE_OTP_ENABLED=true
EMAIL_OTP_ENABLED=true
# Supply a random secret of at least 32 UTF-8 bytes outside source control.
OTP_HASH_KEY=

# Use true with HTTPS in production; false is for local HTTP development only.
APPLICANT_SESSION_SECURE_COOKIE=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Console-only mock is enabled by application-dev.properties; rejected outside dev/test.
OTP_MOCK_DELIVERY=true

# Google OAuth2 credentials (Client Secret must never be exposed to frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
